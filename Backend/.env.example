# Copia este archivo como .env y ajusta los valores de tu PC

# Puerto de la API
PORT=4000

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=MesaAyuda_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña

# Clave para firmar los JWT (cualquier texto largo y secreto)
JWT_SECRET=cambia_esto_por_un_texto_largo_y_secreto

# Dirección del Frontend (CORS con cookies y Socket.io)
FRONTEND_URL=http://localhost:5173

# Opcionales (estos son los valores por defecto)
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_DAYS=7
# SLA_MONITOR_SEGUNDOS=30
